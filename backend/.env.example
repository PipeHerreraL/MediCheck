# ============================================
# Credenciales de ApiMedic / Priaid
# Obtener en: https://apimedic.com/
# ============================================

APIMEDIC_API_KEY=your_api_key_here
APIMEDIC_SECRET_KEY=your_secret_key_here

# URLs de la API (sandbox para desarrollo)
APIMEDIC_AUTH_URL=https://authservice.priaid.ch/login
APIMEDIC_HEALTH_URL=https://sandbox-healthservice.priaid.ch

# Idioma de los resultados médicos
# Opciones: en-gb, es-es, de-ch, fr-fr, it-it, ar-sa, ru-ru, tr-tr
APIMEDIC_LANGUAGE=en-gb

# Puerto del servidor
PORT=3000
